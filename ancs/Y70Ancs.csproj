<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Y70 ANCS bridge.

    Reads iPhone notifications, calls and battery over Bluetooth LE and writes
    them to stdout as JSON lines, exactly like pcstats.ps1 and syscontrol.ps1.

    Why C# and not PowerShell, which the other helpers use: Windows PowerShell
    5.1 flatly cannot subscribe to WinRT events ("Windows PowerShell cannot
    subscribe to Windows RT events") and cannot project IBuffer, and ANCS is
    entirely event-driven over GATT notifications. Targeting a Windows TFM here
    gives first-class WinRT through CsWinRT.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>y70-ancs</AssemblyName>
    <RootNamespace>Y70Ancs</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
